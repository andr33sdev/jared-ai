# Obligatorias
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Tu ID de Telegram (Jared te lo dice la primera vez que le escribís)
TELEGRAM_OWNER_ID=

# Opcionales
OWNER_NAME=Andrés
JARED_MODEL=claude-sonnet-5-5
TIMEZONE=America/Argentina/Buenos_Aires
CITY=Buenos Aires
# Render la completa sola (RENDER_EXTERNAL_URL); en otro hosting poné la URL pública
PUBLIC_URL=
# Audios (transcripción con Whisper en Groq, gratis)
GROQ_API_KEY=
# Google Calendar (cuenta de servicio con tu calendario compartido)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=tu-mail@gmail.com
# Horarios de los mensajes automáticos (hora local)
BRIEF_TIME=08:00
CHECKIN_TIME=16:00
REFLECTION_TIME=23:30
NEWS_IN_BRIEF=true
TTS_VOICE=es-AR-TomasNeural

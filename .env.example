# Obligatorias
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Tu ID de Telegram (Jared te lo dice la primera vez que le escribís)
TELEGRAM_OWNER_ID=

# Opcionales
OWNER_NAME=Andrés
JARED_MODEL=claude-sonnet-5-5
TIMEZONE=America/Argentina/Buenos_Aires
CITY=Buenos Aires
# Render la completa sola (RENDER_EXTERNAL_URL); en otro hosting poné la URL pública
PUBLIC_URL=
# Audios (transcripción con Whisper en Groq, gratis)
GROQ_API_KEY=
# Google Calendar (cuenta de servicio con tu calendario compartido)
GOOGLE_SERVICE_ACCOUNT_JSON=
# En un VPS es más cómodo guardar el JSON en un archivo y poner su ruta acá:
# GOOGLE_SERVICE_ACCOUNT_FILE=/opt/jared/google.json
GOOGLE_CALENDAR_ID=tu-mail@gmail.com
# Horarios de los mensajes automáticos (hora local)
BRIEF_TIME=08:00
CHECKIN_TIME=16:00
REFLECTION_TIME=23:30
NEWS_IN_BRIEF=true
TTS_VOICE=es-AR-TomasNeural
# Gmail solo lectura (OAuth, cliente "Web application")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
WEEKLY_TIME=21:00
WEEKLY_DAY=6
IDEAS_TIME=19:00
IDEAS_DAY=2
MEETING_PREP=true
# Voz premium para la llamada (ElevenLabs, modelo Flash)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Tope mensual de caracteres (100.000 ≈ USD 4). Al llegar, sigue con la voz gratis.
ELEVENLABS_MONTHLY_CHARS=100000
# Silencio (ms) que espera la llamada antes de responder
CALL_PAUSE_MS=900
